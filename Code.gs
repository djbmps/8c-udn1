var _SCHOOL_MAP = null;
function schoolByCode(code) {
  if (!_SCHOOL_MAP) {
    _SCHOOL_MAP = {};
    SCHOOLS.forEach(function (s) { _SCHOOL_MAP[s.code] = s; });
  }
  return _SCHOOL_MAP[String(code || '').trim()] || null;
}

/* ---------------------------------------------------------------
 *  รหัสผ่าน
 *  • ชื่อผู้ใช้ = รหัสโรงเรียน SMIS 8 หลัก
 *  • รหัสผ่านเริ่มต้น = รหัสโรงเรียน (ยังไม่มีแถวในชีต "ผู้ใช้งาน")
 *  • เก็บเป็นค่าแฮช SHA-256 เท่านั้น ไม่เก็บรหัสผ่านจริง
 * --------------------------------------------------------------- */
function sha(txt) {
  const raw = Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, txt, Utilities.Charset.UTF_8);
  var hex = '';
  for (var i = 0; i < raw.length; i++) {
    var b = raw[i] < 0 ? raw[i] + 256 : raw[i];
    hex += ('0' + b.toString(16)).slice(-2);
  }
  return hex;
}
function hashPass(smis, pass) { return sha(CODE_SALT + '|pw|' + smis + '|' + pass); }
function makeToken(smis, hash) { return sha(CODE_SALT + '|tk|' + smis + '|' + hash).slice(0, 24); }

/** คืนแถวผู้ใช้ในชีต (หรือ null) */
function findUser(smis) {
  const sh = getUserSheet();
  const last = sh.getLastRow();
  if (last < 2) return null;
  const v = sh.getRange(2, 1, last - 1, HEAD_USER.length).getDisplayValues();
  for (var i = 0; i < v.length; i++) {
    if (String(v[i][0]).trim() === String(smis)) {
      return { row: i + 2, hash: String(v[i][3]).trim(), changed: v[i][4], last: v[i][5], count: Number(v[i][6]) || 0 };
    }
  }
  return null;
}

/** ตรวจรหัสผ่าน — คืน {ok, token, school} */
function checkPass(smis, pass) {
  const s = schoolByCode(smis);
  if (!s) return { ok: false, message: 'ไม่พบรหัสโรงเรียนนี้ในระบบ' };
  if (pass == null || String(pass) === '') return { ok: false, message: 'กรุณากรอกรหัสผ่าน' };
  const u = findUser(smis);
  const h = hashPass(smis, String(pass));
  const expect = u ? u.hash : hashPass(smis, smis);   // ยังไม่เคยตั้งรหัส → ใช้รหัสโรงเรียน
  if (h !== expect) return { ok: false, message: 'รหัสผ่านไม่ถูกต้อง' };
  return { ok: true, token: makeToken(smis, expect), school: s, isDefault: !u };
}

/** ตรวจ token ที่ส่งมาพร้อมการบันทึกข้อมูล */
function checkToken(smis, token) {
  const u = findUser(smis);
  const expect = u ? u.hash : hashPass(smis, smis);
  return String(token || '') === makeToken(smis, expect);
}

function touchLogin(smis) {
  try {
    const s = schoolByCode(smis);
    const sh = getUserSheet();
    const stamp = Utilities.formatDate(new Date(), 'Asia/Bangkok', 'dd/MM/yyyy HH:mm:ss');
    const u = findUser(smis);
    if (u) {
      sh.getRange(u.row, 6, 1, 2).setValues([[stamp, u.count + 1]]);
    } else {
      sh.appendRow(["'" + smis, s ? s.name : '', s ? s.group : '', '', '', stamp, 1]);
    }
  } catch (e) { }
}

/* ---------------------------------------------------------------
 *  doPost — submit / login / changepass / resetpass
 * --------------------------------------------------------------- */
function doPost(e) {
  const lock = LockService.getScriptLock();
  try {
    lock.waitLock(30000);
    const d = JSON.parse(e.postData.contents);

    /* ---------- เข้าสู่ระบบ ---------- */
    if (d.action === 'login') {
      const r = checkPass(String(d.user || '').trim(), String(d.pass || ''));
      if (!r.ok) return json(r);
      touchLogin(String(d.user).trim());
      return json({
        ok: true, token: r.token, isDefault: r.isDefault,
        smis: r.school.code, school: r.school.name, group: r.school.group,
        district: r.school.amphoe, tambon: r.school.tambon,
        size: r.school.size, total: r.school.total, grades: r.school.grades,
        message: 'เข้าสู่ระบบสำเร็จ'
      });
    }

    /* ---------- เปลี่ยนรหัสผ่าน ---------- */
    if (d.action === 'changepass') {
      const smis = String(d.user || '').trim();
      const r = checkPass(smis, String(d.pass || ''));
      if (!r.ok) return json({ ok: false, message: 'รหัสผ่านเดิมไม่ถูกต้อง' });
      const np = String(d.newpass || '');
      if (np.length < 6) return json({ ok: false, message: 'รหัสผ่านใหม่ต้องยาวอย่างน้อย 6 ตัวอักษร' });
      if (np.length > 60) return json({ ok: false, message: 'รหัสผ่านใหม่ยาวเกินไป' });
      if (np === smis) return json({ ok: false, message: 'รหัสผ่านใหม่ต้องไม่ซ้ำกับรหัสโรงเรียน' });
      const nh = hashPass(smis, np);
      const sh = getUserSheet();
      const stamp = Utilities.formatDate(new Date(), 'Asia/Bangkok', 'dd/MM/yyyy HH:mm:ss');
      const u = findUser(smis);
      const s = schoolByCode(smis);
      if (u) sh.getRange(u.row, 4, 1, 2).setValues([[nh, stamp]]);
      else sh.appendRow(["'" + smis, s ? s.name : '', s ? s.group : '', nh, stamp, stamp, 1]);
      return json({ ok: true, token: makeToken(smis, nh), message: 'เปลี่ยนรหัสผ่านเรียบร้อยแล้ว' });
    }

    /* ---------- ผู้ดูแลระบบรีเซ็ตรหัสผ่านของโรงเรียน ---------- */
    if (d.action === 'resetpass') {
      if (String(d.token || '') !== ADMIN_PASS) return json({ ok: false, message: 'รหัสผ่านผู้ดูแลไม่ถูกต้อง' });
      const smis = String(d.smis || '').trim();
      const s = schoolByCode(smis);
      if (!s) return json({ ok: false, message: 'ไม่พบรหัสโรงเรียนนี้' });
      const sh = getUserSheet();
      const u = findUser(smis);
      if (u) sh.deleteRow(u.row);
      return json({ ok: true, message: 'รีเซ็ตรหัสผ่านของ ' + s.name + ' กลับเป็นรหัสโรงเรียนแล้ว' });
    }

    /* ---------- บันทึกข้อมูลรายห้อง ---------- */
    if (d.action !== 'submit') return json({ ok: false, message: 'คำสั่งไม่ถูกต้อง' });
    if (!OPEN_FOR_SUBMIT) return json({ ok: false, message: 'ขณะนี้ปิดรับข้อมูลชั่วคราว กรุณาติดต่อผู้ดูแลระบบ' });

    const smis = String(d.user || '').trim();
    const sc = schoolByCode(smis);
    if (!sc) return json({ ok: false, message: 'ไม่พบรหัสโรงเรียน กรุณาเข้าสู่ระบบใหม่' });
    if (!checkToken(smis, d.token)) return json({ ok: false, message: 'หมดอายุการเข้าสู่ระบบ กรุณาเข้าสู่ระบบใหม่' });

    var need = ['year', 'term', 'grade', 'room', 'nAll', 'reporter', 'position', 'phone'];
    for (var i = 0; i < need.length; i++) {
      if (!d[need[i]] || String(d[need[i]]).trim() === '') {
        return json({ ok: false, message: 'ข้อมูลไม่ครบถ้วน (' + need[i] + ')' });
      }
    }
    if (LEVELS.indexOf(String(d.grade)) < 0) return json({ ok: false, message: 'ระดับชั้นไม่ถูกต้อง' });

    const room = Number(d.room);
    if (!(room >= 1 && room <= 20) || Math.round(room) !== room) {
      return json({ ok: false, message: 'ห้องที่ต้องเป็นตัวเลข 1–20' });
    }
    const nAll = Number(d.nAll || 0);
    if (!(nAll >= 1 && nAll <= 300) || Math.round(nAll) !== nAll) {
      return json({ ok: false, message: 'จำนวนนักเรียนในห้องต้องเป็นตัวเลข 1–300' });
    }

    /* จำนวนนักเรียนแต่ละระดับ ของทั้ง 8 ด้าน — แต่ละด้านต้องรวมเท่ากับจำนวนนักเรียนในห้อง */
    const dist = [], means = [];
    for (var k = 0; k < C_KEYS.length; k++) {
      const arr = [];
      var sum = 0, tot = 0;
      for (var L = 1; L <= 4; L++) {
        const n = Number(d[C_KEYS[k] + '_' + L]);
        if (!(n >= 0) || Math.round(n) !== n) {
          return json({ ok: false, message: 'จำนวนนักเรียนต้องเป็นจำนวนเต็ม (' + C_KEYS[k] + ' ระดับ ' + L + ')' });
        }
        arr.push(n); sum += n; tot += n * L;
      }
      if (sum !== nAll) {
        return json({
          ok: false,
          message: C_KEYS[k] + ': จำนวนนักเรียนรวม ' + sum + ' คน ไม่เท่ากับจำนวนนักเรียนในห้อง ' + nAll + ' คน'
        });
      }
      dist.push(arr);
      means.push(Math.round((tot / nAll) * 100) / 100);
    }
    const avg = Math.round((means.reduce(function (a, b) { return a + b; }, 0) / 8) * 100) / 100;
    const quality = qualityLabel(avg);
    if (d.evidence && !/^https?:\/\/.+/i.test(String(d.evidence))) {
      return json({ ok: false, message: 'ลิงก์หลักฐานต้องขึ้นต้นด้วย http:// หรือ https://' });
    }

    const sh = getSheet();
    const now = new Date();
    const stamp = Utilities.formatDate(now, 'Asia/Bangkok', 'dd/MM/yyyy HH:mm:ss');
    const label = (LEVEL_ABBR[d.grade] || d.grade) + '/' + room;

    const found = findRow(sh, d.year, d.term, smis, d.grade, room);
    const seq = found ? found.seq : Math.max(0, sh.getLastRow() - 1) + 1;
    const refCode = found ? found.refCode : makeRef(now, seq);
    const created = found ? found.created : stamp;

    var skillCells = [];
    for (var j = 0; j < 8; j++) skillCells = skillCells.concat(dist[j]).concat([means[j]]);

    const row = [
      seq, created, found ? stamp : '', refCode,
      String(d.year), String(d.term), sc.amphoe, sc.group, "'" + sc.code, sc.name,
      d.grade, room, label, nAll
    ]
      .concat(skillCells)
      .concat([avg, quality, d.strength || '', d.improve || '', d.evidence || '',
        d.reporter, d.position, "'" + String(d.phone), "'" + String(d.contact || ''), d.note || '']);

    if (found) sh.getRange(found.row, 1, 1, HEAD_ROOM.length).setValues([row]);
    else sh.appendRow(row);

    return json({
      ok: true, refCode: refCode, avg: avg, quality: quality, label: label, means: means,
      updated: !!found,
      message: found ? 'ปรับปรุงข้อมูลเดิมเรียบร้อย' : 'บันทึกข้อมูลใหม่เรียบร้อย'
    });

  } catch (err) {
    return json({ ok: false, message: 'เกิดข้อผิดพลาดที่เซิร์ฟเวอร์: ' + err.message });
  } finally {
    try { lock.releaseLock(); } catch (e2) { }
  }
}

/* ---------------------------------------------------------------
 *  doGet — API (JSONP) — แดชบอร์ดเปิดสาธารณะ ไม่ต้องล็อกอิน
 *    ?action=area                    → ข้อมูลทุกห้องทั้งเขต (ตัดข้อมูลติดต่อออก)
 *    ?action=school&smis=41010001    → ข้อมูลเฉพาะโรงเรียนนั้น (ตัดข้อมูลติดต่อออก)
 *    ?action=list&token=รหัสผู้ดูแล   → ข้อมูลเต็มรวมข้อมูลติดต่อ (เฉพาะเขต)
 *    ?action=users&token=รหัสผู้ดูแล  → สถานะบัญชีโรงเรียน (เฉพาะเขต)
 * --------------------------------------------------------------- */
function doGet(e) {
  const p = (e && e.parameter) ? e.parameter : {};
  const cb = p.callback;
  var out;

  try {
    if (p.action === 'area') {
      out = { ok: true, rows: readAll(true), open: OPEN_FOR_SUBMIT };

    } else if (p.action === 'school') {
      const s = schoolByCode(p.smis);
      out = s
        ? {
            ok: true, smis: s.code, school: s.name, group: s.group, district: s.amphoe,
            tambon: s.tambon, size: s.size, total: s.total, grades: s.grades,
            rows: readAll(true).filter(function (r) { return r.smis === s.code; })
          }
        : { ok: false, message: 'ไม่พบรหัสโรงเรียนนี้' };

    } else if (p.action === 'list') {
      out = (p.token === ADMIN_PASS)
        ? { ok: true, rows: readAll(false), cHead: C_HEAD }
        : { ok: false, message: 'รหัสผ่านไม่ถูกต้อง' };

    } else if (p.action === 'users') {
      out = (p.token === ADMIN_PASS)
        ? { ok: true, users: userStatus() }
        : { ok: false, message: 'รหัสผ่านไม่ถูกต้อง' };

    } else {
      out = { ok: true, message: 'ระบบเก็บข้อมูลทักษะ 8C — สพป.อุดรธานี เขต 1', open: OPEN_FOR_SUBMIT };
    }
  } catch (err) {
    out = { ok: false, message: err.message };
  }
  return cb ? jsonp(cb, out) : json(out);
}

/* ---------------------------------------------------------------
 *  ฟังก์ชันช่วย
 * --------------------------------------------------------------- */
function qualityLabel(avg) {
  if (avg >= 3.51) return 'ดีเยี่ยม';
  if (avg >= 2.51) return 'ดี';
  if (avg >= 1.51) return 'พอใช้';
  return 'ควรพัฒนา';
}

function makeRef(now, n) {
  const y = (now.getFullYear() + 543).toString().slice(-2);
  return 'RM' + y + '-' + ('00000' + n).slice(-5);
}

/** ค้นหาแถวเดิมจาก ปีการศึกษา + ภาคเรียน + รหัสโรงเรียน + ระดับชั้น + ห้อง */
function findRow(sh, year, term, smis, grade, room) {
  const last = sh.getLastRow();
  if (last < 2) return null;
  const v = sh.getRange(2, 1, last - 1, HEAD_ROOM.length).getDisplayValues();
  for (var i = 0; i < v.length; i++) {
    if (String(v[i][4]) === String(year) && String(v[i][5]) === String(term) &&
      String(v[i][8]) === String(smis) && String(v[i][10]) === String(grade) &&
      String(v[i][11]) === String(room)) {
      return { row: i + 2, seq: v[i][0], refCode: v[i][3], created: v[i][1] };
    }
  }
  return null;
}

function readAll(publicOnly) {
  const sh = getSheet();
  const last = sh.getLastRow();
  if (last < 2) return [];
  const v = sh.getRange(2, 1, last - 1, HEAD_ROOM.length).getDisplayValues();
  return v.map(function (r) {
    const T = TAIL_START;
    const o = {
      seq: r[0], created: r[1], updated: r[2], refCode: r[3],
      year: r[4], term: r[5], district: r[6], schoolGroup: r[7], smis: String(r[8]).trim(), school: r[9],
      grade: r[10], room: r[11], label: r[12], nAll: Number(r[13]) || 0,
      avg: Number(r[T]) || 0, quality: r[T + 1],
      strength: r[T + 2], improve: r[T + 3], evidence: r[T + 4],
      reporter: r[T + 5], position: r[T + 6]
    };
    if (!publicOnly) {
      o.phone = r[T + 7]; o.contact = r[T + 8]; o.note = r[T + 9];
    }
    o.nEval = o.nAll;
    o.c = []; o.dist = [];
    for (var k = 0; k < 8; k++) {
      const b = SKILL_START + k * 5;
      o.dist.push([Number(r[b]) || 0, Number(r[b + 1]) || 0, Number(r[b + 2]) || 0, Number(r[b + 3]) || 0]);
      o.c.push(Number(r[b + 4]) || 0);
    }
    return o;
  }).reverse();
}

/** สถานะบัญชีของทุกโรงเรียน (สำหรับหน้าเขต) */
function userStatus() {
  const sh = getUserSheet();
  const last = sh.getLastRow();
  const map = {};
  if (last >= 2) {
    sh.getRange(2, 1, last - 1, HEAD_USER.length).getDisplayValues().forEach(function (r) {
      map[String(r[0]).trim()] = { changed: r[4], last: r[5], count: Number(r[6]) || 0, custom: !!String(r[3]).trim() };
    });
  }
  return SCHOOLS.map(function (s) {
    const u = map[s.code] || {};
    return {
      smis: s.code, school: s.name, group: s.group, district: s.amphoe,
      custom: !!u.custom, changed: u.changed || '', last: u.last || '', count: u.count || 0
    };
  });
}

function getSheet() {
  const ss = SpreadsheetApp.openById(SHEET_ID);
  var sh = ss.getSheetByName(SHEET_ROOM);
  if (!sh) sh = ss.insertSheet(SHEET_ROOM);
  if (sh.getLastRow() === 0) {
    writeHeader(sh);
  } else {
    const cur = sh.getRange(1, 1, 1, HEAD_ROOM.length).getDisplayValues()[0];
    if (cur[8] !== HEAD_ROOM[8] || cur[SKILL_START] !== HEAD_ROOM[SKILL_START]) writeHeader(sh);
  }
  return sh;
}

function writeHeader(sh) {
  sh.getRange(1, 1, 1, HEAD_ROOM.length).setValues([HEAD_ROOM]);
  const h = sh.getRange(1, 1, 1, HEAD_ROOM.length);
  h.setFontWeight('bold').setBackground('#4c2a96').setFontColor('#ffffff')
    .setVerticalAlignment('middle').setHorizontalAlignment('center').setWrap(true);
  sh.setFrozenRows(1);
  sh.setFrozenColumns(13);
  sh.setRowHeight(1, 70);
  const w = [55, 140, 140, 110, 85, 75, 115, 240, 105, 225, 160, 65, 85, 120];
  for (var k = 0; k < 8; k++) w.push(78, 78, 78, 78, 100);
  [105, 105, 250, 250, 210, 185, 155, 120, 145, 210].forEach(function (x) { w.push(x); });
  w.forEach(function (x, i) { if (i < HEAD_ROOM.length) sh.setColumnWidth(i + 1, x); });
}

function getUserSheet() {
  const ss = SpreadsheetApp.openById(SHEET_ID);
  var sh = ss.getSheetByName(SHEET_USER);
  if (!sh) sh = ss.insertSheet(SHEET_USER);
  if (sh.getLastRow() === 0) {
    sh.getRange(1, 1, 1, HEAD_USER.length).setValues([HEAD_USER]);
    sh.getRange(1, 1, 1, HEAD_USER.length).setFontWeight('bold')
      .setBackground('#3866eb').setFontColor('#ffffff').setHorizontalAlignment('center');
    sh.setFrozenRows(1);
    [105, 230, 240, 420, 150, 150, 90].forEach(function (x, i) { sh.setColumnWidth(i + 1, x); });
  }
  return sh;
}

function json(obj) {
  return ContentService.createTextOutput(JSON.stringify(obj))
    .setMimeType(ContentService.MimeType.JSON);
}

function jsonp(cb, obj) {
  const safeCb = String(cb).replace(/[^A-Za-z0-9_$]/g, '');
  return ContentService.createTextOutput(safeCb + '(' + JSON.stringify(obj) + ');')
    .setMimeType(ContentService.MimeType.JAVASCRIPT);
}

/* ---------------------------------------------------------------
 *  ▶ ทดสอบการตั้งค่า — กด Run ฟังก์ชันนี้เพื่อตรวจการเชื่อมต่อ
 * --------------------------------------------------------------- */
function ทดสอบการตั้งค่า() {
  var msg = [];
  try {
    var sh = getSheet();
    msg.push('✅ เชื่อมต่อ Google Sheet สำเร็จ: ' + sh.getParent().getName());
    msg.push('   • แผ่นงาน "' + sh.getName() + '" (' + Math.max(0, sh.getLastRow() - 1) + ' ห้อง)');
    var us = getUserSheet();
    msg.push('   • แผ่นงาน "' + us.getName() + '" (' + Math.max(0, us.getLastRow() - 1) + ' บัญชี)');
  } catch (e) { msg.push('❌ Google Sheet: ' + e.message); }
  try {
    var groups = {};
    SCHOOLS.forEach(function (s) { groups[s.group] = 1; });
    msg.push('✅ รายชื่อโรงเรียน ' + Object.keys(groups).length + ' กลุ่ม / ' + SCHOOLS.length + ' โรงเรียน');
    msg.push('   • ตัวอย่างบัญชี: ' + SCHOOLS[0].code + ' (' + SCHOOLS[0].name + ') รหัสผ่านเริ่มต้น = ' + SCHOOLS[0].code);
  } catch (e) { msg.push('❌ รายชื่อโรงเรียน: ' + e.message); }
  msg.push(OPEN_FOR_SUBMIT ? '✅ ระบบเปิดรับข้อมูล' : '⚠️ ระบบปิดรับข้อมูลอยู่');
  Logger.log(msg.join('\n'));
  return msg.join('\n');
}

/* ---------------------------------------------------------------
 *  ▶ รีเซ็ตรหัสผ่านโรงเรียนทั้งหมด — ล้างชีต "ผู้ใช้งาน"
 *     ทุกโรงเรียนจะกลับไปใช้รหัสโรงเรียนเป็นรหัสผ่าน
 * --------------------------------------------------------------- */
function รีเซ็ตรหัสผ่านทุกโรงเรียน() {
  const sh = getUserSheet();
  const last = sh.getLastRow();
  if (last > 1) sh.deleteRows(2, last - 1);
  Logger.log('รีเซ็ตรหัสผ่านของทุกโรงเรียนกลับเป็นรหัสโรงเรียนแล้ว');
  return 'ok';
}
